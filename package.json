{
  "name": "onesimus-wheels",
  "version": "1.0.0",
  "private": true,
  "description": "Practical information for bicycle repair, bike libraries, cycling groups and safer riding across African cities.",
  "engines": {
    "node": "24.x",
    "npm": ">=10"
  },
  "scripts": {
    "dev": "next dev --hostname 0.0.0.0 --port 3000",
    "build": "next build",
    "start": "next start --hostname 0.0.0.0 --port 3000",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "node scripts/test.mjs",
    "audit:content": "node scripts/audit-content.mjs",
    "gate": "npm run lint && npm run typecheck && npm run audit:content && npm run build"
  },
  "dependencies": {
    "next": "16.4.3",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.14.0",
    "@fontsource/poppins": "5.3.0",
    "@fontsource/raleway": "5.3.0",
    "@playwright/test": "1.64.1",
    "@sparticuz/chromium": "153.0.0",
    "@tailwindcss/postcss": "4.3.3",
    "@types/node": "24.19.2",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "eslint": "9.39.5",
    "eslint-config-next": "16.4.3",
    "font-awesome": "4.7.0",
    "tailwindcss": "4.3.3",
    "typescript": "5.9.3"
  }
}
